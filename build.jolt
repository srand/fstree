    @Test.parameterized([0o777])
    @runner
    def test_ignored_files_retained_on_checkout(self):
        """
        Test that files and directories can be ignored.
        ---
        ignores:
        - dir2
        - file2
        tree:
        - d {0} dir
        - f {0} file
        - l {0} link file
        - d {0} dir2
        - f {0} dir2/file
        - l {0} dir2/link file
        - f {0} file2
        - d {0} dir3
        - f {0} dir3/file
        - l {0} dir3/link file
        checkout:
        - d {0} dir
        - f {0} file
        - l {0} link file
        - d {0} dir2
        - f {0} dir2/file2
        expected:
        - d {0} dir
        - f {0} file
        - l {0} link file
        - d {0} dir2
        - f {0} dir2/file2
        - d {0} dir3
        - f {0} dir3/file
        - l {0} dir3/link file
        """


    @Test.parameterized([0o777])
    @runner
    def test_ignore_negation(self):
        """
        Test that a negated pattern re-includes an ignored file, and that it
        cannot re-include anything below an ignored directory.
        ---
        ignores:
        - '*.log'
        - '!keep.log'
        - dir2
        - '!dir2/keep.log'
        tree:
        - d {0} dir
        - f {0} dir/app.log
        - f {0} dir/keep.log
        - f {0} file
        - d {0} dir2
        - f {0} dir2/keep.log
        expected:
        - d {0} dir
        - f {0} dir/keep.log
        - f {0} file
        """

    def write_tree(self, *args):
        # The last line of output is the tree hash. A warning about a missing
        # index may come before it.
        return self.tools.run("fstree write-tree " + " ".join(args)).strip().splitlines()[-1]

    def test_ignore_changed_without_touching_directories(self):
        """
        Test that changing the ignore file between two writes of a tree takes
        effect in nested directories, whose own metadata does not change.
        """
        with self.tools.tmpdir("ignore-changed") as tmp, self.tools.cwd(tmp):
            self.tools.mkdir("tree")
            with self.tools.cwd("tree"):
                self.tools.write_file(".fstreeignore", "")
                self.tools.mkdir("a/b/c/d")
                self.tools.mkdir("a/b/keep")
                self.tools.write_file("a/b/c/file")
                self.tools.write_file("a/b/c/d/file")
                self.tools.write_file("a/b/keep/file")
                self.tools.write_file("a/b/file.o")

            # Index the tree, so that the next writes can reuse the hashes of
            # unchanged directories
            self.write_tree("tree")

            for patterns in ["c/\n*.o", ""]:
                self.tools.write_file(os.path.join("tree", ".fstreeignore"), patterns)

                tree = self.write_tree("tree")
                fresh = self.write_tree("--index", os.path.join(tmp, "fresh-index"), "tree")
                self.tools.unlink(os.path.join(tmp, "fresh-index"))
                self.assertEqual(fresh, tree, "ignores: " + repr(patterns))

    def test_write_tree_paths(self):
        """
        Test that write-tree with paths after the directory refreshes only
        those paths of the index and gives the same tree as a full refresh
        when nothing else changed, and that changes elsewhere are kept out.
        """
        with self.tools.tmpdir("write-tree-paths") as tmp, self.tools.cwd(tmp):
            ignores = "--ignore-pattern .git --ignore-pattern /build/"
            self.create_files("tree", ["repo/src/a", "other/b", "top", "build/out"])

            def write(*paths):
                return self.write_tree(ignores, "tree", *paths)

            def fresh():
                tree = self.write_tree(ignores, "--index", os.path.join(tmp, "fresh-index"), "tree")
                self.tools.unlink(os.path.join(tmp, "fresh-index"))
                return tree

            write()

            def change(name, *paths):
                self.assertEqual(fresh(), write(*paths), name)

            self.tools.write_file("tree/repo/src/a", "changed")
            change("changed file", "repo")

            self.create_files("tree", ["repo/src/new", "repo/inc/h"])
            change("added files and directory", "repo")

            self.tools.rmtree("tree/repo/inc")
            change("removed directory", "repo/inc")

            self.create_files("tree", ["deep/x/y/z"])
            change("new directories on the path", "deep/x/y")

            self.create_files("tree", ["repo/.git/HEAD", "build/more"])
            change("ignored entries", "repo", "build")

            self.create_files("tree", ["repo/c", "other/c"])
            change("several paths, relative and absolute", "repo", os.path.join(tmp, "tree", "other"))

            self.tools.write_file("tree/top", "changed")
            change("file at the top", "top")

            if os.name != "nt":
                os.chmod(os.path.join(tmp, "tree", "repo", "c"), 0o755)
                change("permissions", "repo/c")

                os.symlink("repo", os.path.join(tmp, "tree", "link"))
                change("new symlink", "link")

            self.tools.unlink("tree/top")
            change("removed file", "top")

            self.tools.rmtree("tree/repo")
            change("removed directory with entries", "repo")

            # A change outside the paths is not picked up
            self.create_files("tree", ["other/outside"])
            self.assertNotEqual(fresh(), write("deep"))
            change("full refresh", ".")

            with self.assertRaises(Exception):
                write("../outside")

    def files(self, root):
        """Returns the paths of the files below a directory, without .fstree."""
        result = set()
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if d != ".fstree"]
            for name in filenames:
                result.add(os.path.relpath(os.path.join(dirpath, name), root).replace(os.sep, "/"))
        return result

    def create_files(self, root, paths):
        for path in paths:
            self.tools.mkdirname(os.path.join(root, path))
            self.tools.write_file(os.path.join(root, path), path)

    def test_ignore_pattern(self):
        """
        Test that patterns given with --ignore-pattern, or in the environment,
        are applied after those of the ignore file, when writing a tree and
        when checking it out.
        """
        patterns = "--ignore .joltignore --ignore-pattern .git --ignore-pattern /build/"

        with self.tools.tmpdir("ignore-pattern") as tmp, self.tools.cwd(tmp):
            self.create_files("tree", [
                "src/a", "a.log", "keep.log", ".git/HEAD", "build/out", "other/build/out"])
            # A pattern given on the command line overrides the file
            self.tools.write_file("tree/.joltignore", "*.log\n!keep.log\n!.git\n")

            tree = self.write_tree(patterns, "tree")

            self.tools.run("fstree checkout {} {} fresh", patterns, tree)
            self.assertEqual(
                {".joltignore", "keep.log", "other/build/out", "src/a"},
                self.files(os.path.join(tmp, "fresh")))

            # The same patterns given in the environment, one per line
            with self.tools.environ(FSTREE_IGNORE_PATTERN=".git\n/build/\n"):
                self.tools.rmtree(os.path.join(tmp, "tree", ".fstree"))
                self.assertEqual(tree, self.write_tree("--ignore .joltignore", "tree"))

            # A checkout with the patterns keeps what they ignore
            self.create_files("worker", [".git/HEAD", "build/out", "a.log"])
            self.tools.run("fstree checkout {} {} worker", patterns, tree)
            self.assertEqual(
                {".git/HEAD", "build/out", "a.log", ".joltignore", "keep.log", "other/build/out", "src/a"},
                self.files(os.path.join(tmp, "worker")))

            # Without them, the ignore file alone does not ignore .git
            self.create_files("bare", [".git/HEAD", "build/out", "a.log"])
            self.tools.run("fstree checkout --ignore .joltignore {} bare", tree)
            self.assertEqual(
                {"a.log", ".joltignore", "keep.log", "other/build/out", "src/a"},
                self.files(os.path.join(tmp, "bare")))

    def create_moded_tree(self, root, file_mode, exec_mode, dir_mode):
        """Creates a tree as if checked out with some umask, with given modes."""
        self.tools.mkdir(root)
        with self.tools.cwd(root):
            self.tools.mkdir("dir/sub")
            self.tools.write_file("file", "file")
            self.tools.write_file("run.sh", "#!/bin/sh")
            self.tools.write_file("dir/sub/file", "sub")
            self.tools.symlink("../file", "dir/link")
            for path, mode in [("file", file_mode), ("dir/sub/file", file_mode),
                               ("run.sh", exec_mode),
                               ("dir/sub", dir_mode), ("dir", dir_mode)]:
                os.chmod(self.tools.expand_path(path), mode)
            # On macOS, the umask also decides the mode of a symlink
            if hasattr(os, "lchmod"):
                os.lchmod(self.tools.expand_path("dir/link"), 0o777)

    def modes(self, root):
        """Returns the permissions of the entries of a tree by path."""
        result = {}
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if d != ".fstree"]
            for name in dirnames + filenames:
                path = os.path.join(dirpath, name)
                if not os.path.islink(path):
                    result[os.path.relpath(path, root)] = os.lstat(path).st_mode & 0o7777
        return result

    def test_permissions_git_ignores_umask(self):
        """
        Test that with --permissions git, trees written from checkouts made
        with different umasks are equal, and that without it they differ.
        """
        if os.name == "nt":
            self.skipTest("permissions are not POSIX modes on Windows")

        with self.tools.tmpdir("permissions-git") as tmp, self.tools.cwd(tmp):
            self.create_moded_tree("umask022", 0o644, 0o755, 0o755)
            self.create_moded_tree("umask002", 0o664, 0o775, 0o775)
            self.create_moded_tree("readonly", 0o444, 0o555, 0o555)

            exact = [self.write_tree(t) for t in ["umask022", "umask002", "readonly"]]
            self.assertEqual(3, len(set(exact)))

            git = [self.write_tree("--permissions git", t) for t in ["umask022", "umask002", "readonly"]]
            self.assertEqual(1, len(set(git)))

            # With exact permissions, the tree written in git mode is that
            # of the checkout made with umask 022
            self.assertEqual(exact[0], git[0])

            with self.assertRaises(Exception):
                self.write_tree("--permissions bogus", "umask022")

    def test_permissions_git_checkout_applies_umask(self):
        """
        Test that a checkout with --permissions git creates files and
        directories as git does, with permissions given by the umask, and
        that writing the checkout gives back the same tree.
        """
        if os.name == "nt":
            self.skipTest("permissions are not POSIX modes on Windows")

        with self.tools.tmpdir("permissions-checkout") as tmp, self.tools.cwd(tmp):
            self.create_moded_tree("tree", 0o600, 0o700, 0o700)
            tree_exact = self.write_tree("tree")
            tree_git = self.write_tree("--permissions git", "tree")
            self.assertNotEqual(tree_exact, tree_git)

            expected = {
                "file": 0o664, "run.sh": 0o775, "dir": 0o775,
                "dir/sub": 0o775, "dir/sub/file": 0o664,
            }

            # Either tree checks out as git would, also the one written with
            # exact permissions, and writes back as the tree in git mode
            for tree, name in [(tree_git, "git"), (tree_exact, "exact")]:
                self.tools.run("umask 002 && fstree --permissions git checkout {} {}", tree, name)
                self.assertEqual(expected, self.modes(os.path.join(tmp, name)), name)
                self.assertEqual(tree_git, self.write_tree("--permissions git", name), name)

            # A changed executable bit of an existing file is restored, and
            # the permissions of entries otherwise left alone
            os.chmod(os.path.join(tmp, "git", "run.sh"), 0o664)
            os.chmod(os.path.join(tmp, "git", "file"), 0o640)
            self.tools.run("umask 002 && fstree --permissions git checkout {} git", tree_git)
            self.assertEqual(dict(expected, file=0o640), self.modes(os.path.join(tmp, "git")))

            # A checkout with exact permissions gives the modes recorded in
            # the tree, whatever the umask
            self.tools.run("umask 002 && fstree checkout {} exact-checkout", tree_git)
            self.assertEqual(
                {"file": 0o644, "run.sh": 0o755, "dir": 0o755, "dir/sub": 0o755, "dir/sub/file": 0o644},
                self.modes(os.path.join(tmp, "exact-checkout")))

    def test_cat_file(self):
        """Test that cat-file prints file objects as is and trees as ls-tree."""
        files = {"text": b"line\r\nline\n", "binary": bytes(range(256)), "empty": b""}

        with self.tools.tmpdir("cat-file") as tmp, self.tools.cwd(tmp):
            self.tools.mkdir("tree")
            for name, content in files.items():
                with open(os.path.join(tmp, "tree", name), "wb") as stream:
                    stream.write(content)

            tree = self.write_tree("tree")
            self.assertEqual(
                self.tools.run("fstree ls-tree {}", tree),
                self.tools.run("fstree cat-file {}", tree))

            for line in self.tools.run("fstree ls-tree {}", tree).splitlines():
                digest, name = line.split()[0], line.split()[-1]
                self.tools.run("fstree cat-file {} > {}", digest, os.path.join(tmp, "out"))
                with open(os.path.join(tmp, "out"), "rb") as stream:
                    self.assertEqual(files[name], stream.read(), name)

            # A digest of the algorithm in use that is in the cache neither as
            # a file nor as a tree
            alg, hexdigest = tree.split(":")
            with self.assertRaises(Exception):
                self.tools.run("fstree cat-file {}:{}", alg, "0" * len(hexdigest))


class Publish(Task):
    """ Downloads release wheels from GitHub and publishes them to PyPI. """

    version = Parameter("Version to publish")

    base_url = "https://github.com/srand/fstree/releases/download/{version_long}/"

    wheels = [
        "pyfstree-{version}-cp310-cp310-macosx_11_0_arm64.whl",
        "pyfstree-{version}-cp310-cp310-manylinux_2_28_x86_64.whl",
        "pyfstree-{version}-cp310-cp310-musllinux_1_2_x86_64.whl",
        "pyfstree-{version}-cp310-cp310-win_amd64.whl",

        "pyfstree-{version}-cp311-cp311-macosx_11_0_arm64.whl",
        "pyfstree-{version}-cp311-cp311-manylinux_2_28_x86_64.whl",
        "pyfstree-{version}-cp311-cp311-musllinux_1_2_x86_64.whl",
        "pyfstree-{version}-cp311-cp311-win_amd64.whl",

        "pyfstree-{version}-cp312-cp312-macosx_11_0_arm64.whl",
        "pyfstree-{version}-cp312-cp312-manylinux_2_28_x86_64.whl",
        "pyfstree-{version}-cp312-cp312-musllinux_1_2_x86_64.whl",
        "pyfstree-{version}-cp312-cp312-win_amd64.whl",

        "pyfstree-{version}-cp313-cp313-macosx_11_0_arm64.whl",
        "pyfstree-{version}-cp313-cp313-manylinux_2_28_x86_64.whl",
        "pyfstree-{version}-cp313-cp313-musllinux_1_2_x86_64.whl",
        "pyfstree-{version}-cp313-cp313-win_amd64.whl",

        "pyfstree-{version}-cp314-cp314-macosx_11_0_arm64.whl",
        "pyfstree-{version}-cp314-cp314-manylinux_2_28_x86_64.whl",
        "pyfstree-{version}-cp314-cp314-musllinux_1_2_x86_64.whl",
        "pyfstree-{version}-cp314-cp314-win_amd64.whl",
    ]

    @property
    def version_long(self):
        """ Adds a leading 0 to the minor version if it's a single digit. """
        major, minor, patch = str(self.version).split(".")
        if len(minor) == 1:
            minor = "0" + minor
        return f"{major}.{minor}.{patch}"

    def run(self, deps, tools):
        with tools.tmpdir() as tmp, tools.cwd(tmp):
            for wheel in self.wheels:
                tools.download(self.base_url + wheel, wheel)
            tools.run("twine upload *.whl")
