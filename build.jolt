        - l {0} link file
        - d {0} dir2
        - f {0} dir2/file
        - l {0} dir2/link file
        - f {0} file2
        - d {0} dir3
        - f {0} dir3/file
        - l {0} dir3/link file
        checkout:
        - d {0} dir
