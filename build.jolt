class Default(Alias):
    requires = [
        "tests",
    ]


class HttpObjectStore(object):
    """ In-memory HTTP server storing objects for fstree's HTTP remote. """

    def __init__(self):
        self.objects = {}
        self.lock = threading.Lock()
        store = self

        class Handler(BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.1"

            def log_message(self, *args):
                pass

            def reply(self, code, body=b""):
                self.send_response(code)
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                if self.command != "HEAD":
                    self.wfile.write(body)

            def do_HEAD(self):
                with store.lock:
                    found = self.path in store.objects
                self.reply(200 if found else 404)

            def do_GET(self):
                with store.lock:
                    body = store.objects.get(self.path)
                self.reply(404) if body is None else self.reply(200, body)

            def do_PUT(self):
                body = self.rfile.read(int(self.headers.get("Content-Length", 0)))
                with store.lock:
                    store.objects[self.path] = body
                self.reply(201)

        self.server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        self.server.daemon_threads = True
        self.url = "http://127.0.0.1:{}/store".format(self.server.server_address[1])

    @contextlib.contextmanager
    def running(self):
        thread = threading.Thread(target=self.server.serve_forever, daemon=True)
        thread.start()
        try:
            yield self
        finally:
            self.server.shutdown()
            self.server.server_close()
            thread.join()

    def replace(self, content, replacement):
        """ Replace the content of every stored object that has the given content. """
        with self.lock:
            paths = [path for path, body in self.objects.items() if body == content]
            for path in paths:
                self.objects[path] = replacement
        return len(paths)


class Tests(Test):
    requires = ["fstree"]

    def get_config(self, tools, func, *args, **kwargs):
        # Split the docstring into two parts, the first part is the
        # description of the test, the second part is the expected
        # tree structure in YAML format.
        doc = func.__doc__.format(*args, **kwargs)
        doc, tree = doc.split("---", 1)

        # Parse the expected tree structure.
        from io import StringIO
        stream = StringIO(tree)
        return yaml.safe_load(stream)

    def create_ignore(self, tools, ignores):
        # Create the ignore file.
        ignores = "\n".join(ignores)
        self.tools.write_file(".fstreeignore", ignores)

    def create_tree(self, tools, tree):
        # Create the expected tree structure.
        for entry in tree:
            parts = entry.split()
            if parts[0] == "f":
                self.tools.write_file(parts[2])
            elif parts[0] == "d":
                self.tools.mkdir(parts[2])
            elif parts[0] == "l":
                self.tools.symlink(parts[3], parts[2])

            # Set the permissions of the file or directory.
            perms = int(parts[1])
            self.tools.chmod(parts[2], perms)

    def test_unittests(self):
        """
        Run the unittests.
        ---
        """
        self.tools.run("fstree_test")

    def test_irregular_bytes_in_event_paths(self):
        """Test irregular filenames survive checkout and produce UTF-8 JSON."""

        # None of these characters exist in a legacy Windows code page, so they
        # only survive a build that reads and writes paths through the wide
        # entry points. The emoji is outside the BMP and so is a surrogate pair
        # in UTF-16. None of them have a canonical decomposition, which keeps
        # the comparison immune to the normalization macOS applies on HFS+.
        #
        # They are spelled as escapes to keep this recipe pure ASCII: Jolt reads
        # recipes with the locale encoding, which is a legacy code page such as
        # cp1252 on Windows, and any literal non-ASCII byte here would fail to
        # decode before a single task runs.
        filenames = [
            "\u65e5\u672c\u8a9e",  # Japanese "nihongo"
            "\U0001f4c1",  # File folder emoji, U+1F4C1
            "\u041a\u0438\u0440\u0438\u043b\u043b\u0438\u0446\u0430",  # Russian "Kirillica"
        ]

        with self.tools.tmpdir("irregular-bytes") as tmp, self.tools.cwd(tmp):
            source = os.path.join(tmp, "source")
            actual = os.path.join(tmp, "actual")
            os.mkdir(source)
            os.mkdir(actual)

            # Names that are not valid UTF-8 at all are only expressible where
            # the filesystem stores names as opaque bytes. Windows names are
            # UTF-16, and macOS validates the encoding and rejects these with
            # EILSEQ, so add them only where they can actually be created.
            for raw in [b"invalid-\xff", b"truncated-\xe2\x82", b"continuation-\x80"]:
                try:
                    name = os.fsdecode(raw)
                    probe = os.path.join(source, name)
                    os.close(os.open(probe, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600))
                except (OSError, UnicodeError):
                    break
                os.unlink(probe)
                filenames.append(name)

            for filename in filenames:
                with open(os.path.join(source, filename), "wb") as stream:
                    stream.write(os.fsencode(filename))

            invocation = 0

            def run_json(*args):
                nonlocal invocation
                stderr_path = os.path.join(tmp, "events-{}.json".format(invocation))
                invocation += 1
                stdout = self.tools.run(
                    "fstree --json --cache cache {} 2> {}", " ".join(args), stderr_path
                )
                with open(stderr_path, "rb") as stream:
                    stderr_bytes = stream.read()
                try:
                    stderr = stderr_bytes.decode("utf-8")
                except UnicodeDecodeError as error:
                    context = stderr_bytes[max(0, error.start - 80):error.end + 80]
                    raise AssertionError(
                        "event stream is not UTF-8 at byte {}: {!r}".format(error.start, context)
                    ) from error
                events = [json.loads(line) for line in stderr.splitlines()]
                self.assertTrue(events)
                return stdout.strip(), events

            tree, write_events = run_json("write-tree", "source")
            _, checkout_events = run_json("checkout", tree, "actual")

            actual_filenames = set(os.listdir(actual)) - {".fstree"}
            self.assertEqual(actual_filenames, set(filenames))

            # escape() emits one \u00XX escape per byte, so a decoded path is a
            # string of code points 0-255 that latin-1 turns back into exactly
            # the bytes fstree saw.
            event_paths = [
                event.get("path", "").encode("latin-1")
                for event in write_events + checkout_events
            ]
            for filename in filenames:
                encoded = os.fsencode(filename)
                self.assertTrue(any(encoded in path for path in event_paths), repr(filename))

    def push_to_http_store(self, tmp, store, files):
        """ Write files to a tree and push it to the store. Returns the tree digest. """
        for name, content in files.items():
            path = os.path.join(tmp, "tree", name)
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "wb") as stream:
                stream.write(content)

        return self.tools.run(
            "fstree write-tree-push --cache cache --remote {} --index {} tree",
            store.url, os.path.join(tmp, "index")).strip()

    def test_http_remote_push_and_pull(self):
        """Test that a tree pushed to an HTTP remote can be pulled and checked out."""
        files = {"file.txt": b"file", "dir/same.txt": b"same", "other/same.txt": b"same"}

        with self.tools.tmpdir("http-remote") as tmp, self.tools.cwd(tmp):
            with HttpObjectStore().running() as store:
                tree = self.push_to_http_store(tmp, store, files)
                self.tools.run(
                    "fstree pull-checkout --cache pulled --remote {} --index {} {} actual",
                    store.url, os.path.join(tmp, "pulled-index"), tree)

            for name, content in files.items():
                with open(os.path.join(tmp, "actual", name), "rb") as stream:
                    self.assertEqual(content, stream.read(), name)

    def test_http_remote_rejects_corrupt_object(self):
        """Test that an object whose content does not match its digest is not pulled."""

        with self.tools.tmpdir("http-corrupt") as tmp, self.tools.cwd(tmp):
            with HttpObjectStore().running() as store:
                tree = self.push_to_http_store(tmp, store, {"file.txt": b"original content"})

                # A plain HTTP server stores whatever it is given, so an object
                # can be truncated or otherwise differ from its digest.
                self.assertEqual(1, store.replace(b"original content", b"original"))

                with self.assertRaises(Exception):
                    self.tools.run(
                        "fstree pull-checkout --cache pulled --remote {} --index {} {} actual",
                        store.url, os.path.join(tmp, "pulled-index"), tree)

            # The corrupt object must not be stored in the cache under the
            # digest of the original, or every later checkout would use it.
            for root, _, names in os.walk(os.path.join(tmp, "pulled")):
                for name in names:
                    with open(os.path.join(root, name), "rb") as stream:
                        self.assertNotEqual(b"original", stream.read(), name)

    def test_http_remote_cleans_up_failed_download(self):
        """Test that a download that cannot be moved into the cache is removed."""

        with self.tools.tmpdir("http-cleanup") as tmp, self.tools.cwd(tmp):
            with HttpObjectStore().running() as store:
                tree = self.push_to_http_store(tmp, store, {"file.txt": b"content"})

                # Occupy the shard directory names with files, so that no
                # downloaded object can be moved into place.
                objects = os.path.join(tmp, "pulled", "objects")
                os.makedirs(objects)
                for shard in range(256):
                    with open(os.path.join(objects, "{:02x}".format(shard)), "wb"):
                        pass

                with self.assertRaises(Exception):
                    self.tools.run(
                        "fstree pull --cache pulled --remote {} --index {} {}",
                        store.url, os.path.join(tmp, "pulled-index"), tree)

            self.assertEqual([], os.listdir(os.path.join(tmp, "pulled", "tmp")))

    def runner(func):

        @functools.wraps(func)
        def wrap(self, *args, **kwargs):
            # Get the configuration for the test from docstring.
            conf = self.get_config(self.tools, func, *args, **kwargs)

            with self.tools.tmpdir(func.__name__) as tmp, self.tools.cwd(tmp):
                self.tools.mkdir("tree")
                self.tools.mkdir("expected")
                self.tools.mkdir("actual")

                with self.tools.cwd("tree"):
                    if "ignores" in conf:
                        self.create_ignore(self.tools, conf["ignores"])
                    self.create_tree(self.tools, conf.get("tree", []))

                with self.tools.cwd("actual"):
                    self.create_tree(self.tools, conf.get("checkout", []))

                with self.tools.cwd("expected"):
                    # The ignore file is part of the tree and gets checked out
                    # along with it, so the expected result must contain it too.
                    if "ignores" in conf:
                        self.create_ignore(self.tools, conf["ignores"])
                    self.create_tree(self.tools, conf.get("expected", conf.get("tree", [])))

                # Write the tree. The ignore file lives in the source tree and
                # decides what is included, so write-tree must run on that tree
                # and not on the already filtered expected result.
                tree = self.tools.run("fstree write-tree tree")
                self.tools.run("fstree ls-tree {}", tree)

                # Checkout the tree
                self.tools.run("fstree checkout {} actual", tree)

                # Compare the expected tree structure with the actual tree
                if os.name in ["nt"]:
                    self.tools.run("diff.exe -rq --exclude .fstree expected actual")
                else:
                    self.tools.run("diff -rq --exclude .fstree expected actual")

                # Compare trees
                with self.tools.cwd("actual"):
                    self.tools.rmtree(".fstree")
                new_tree = self.tools.run("fstree write-tree actual")
                self.tools.run("fstree ls-tree {}", new_tree)
                self.assertEqual(tree, new_tree)

        return wrap

    @Test.parameterized([
            0o400, 0o440, 0o444, 0o600, 0o640, 0o644,
            0o660, 0o664, 0o666, 0o700, 0o740, 0o744,
            0o750, 0o754, 0o755, 0o760, 0o764, 0o766,
            0o770, 0o774, 0o777
        ] if os.name != "nt" else [0o777, 0o555]
    )
    @runner
    def test_permissions_at_checkout(self):
        """
        Test that permissions of a newly checked out tree matches
        permissions of files and directories of the original tree.
        ---
        tree:
        - d {0} dir
        - f {0} file
        - l {0} link file
        """

    @Test.parameterized([
            0o700, 0o740, 0o744, 0o750, 0o754, 0o755,
            0o760, 0o764, 0o766, 0o770, 0o774, 0o777
        ] if os.name != "nt" else [0o777, 0o555]
    )
    @runner
    def test_dir_permissions_at_checkout(self):
        """
        Test that permissions of a newly checked out tree matches
        permissions of files and directories of the original tree.
        ---
        tree:
        - d {0} dir
        - f {0} dir/file
        - d {0} dir/dir
        - l {0} dir/link file
        """

    @Test.parameterized([
            (0o700, 0o700), (0o700, 0o740), (0o700, 0o744),
            (0o700, 0o750), (0o700, 0o754), (0o700, 0o755),
            (0o700, 0o760), (0o700, 0o764), (0o700, 0o766),
            (0o700, 0o770), (0o700, 0o774), (0o700, 0o777),
        ] if os.name != "nt" else [(0o777, 0o555), (0o555, 0o777)])
    @runner
    def test_type_change_file_to_dir(self):
        """
        Test that the type of a file or directory can be changed.
        ---
        tree:
        - d {0} dir
        - d {0} dir/subdir
        - f {0} dir/file
        checkout:
        - f {0} dir
        - f {0} file
        """

    @Test.parameterized([
            (0o700, 0o700), (0o700, 0o740), (0o700, 0o744),
            (0o700, 0o750), (0o700, 0o754), (0o700, 0o755),
            (0o700, 0o760), (0o700, 0o764), (0o700, 0o766),
            (0o700, 0o770), (0o700, 0o774), (0o700, 0o777),
        ] if os.name != "nt" else [(0o777, 0o555), (0o555, 0o777)])
    @runner
    def test_type_change_dir_to_file(self):
        """
        Test that the type of a file or directory can be changed.
        ---
        tree:
        - f {0} dir
        - f {0} file
        checkout:
        - d {0} dir
        - d {0} dir/subdir
        - f {0} dir/file
        """

    @Test.parameterized([
            (0o700, 0o700), (0o700, 0o740), (0o700, 0o744),
            (0o700, 0o750), (0o700, 0o754), (0o700, 0o755),
            (0o700, 0o760), (0o700, 0o764), (0o700, 0o766),
            (0o700, 0o770), (0o700, 0o774), (0o700, 0o777),
        ] if os.name != "nt" else [(0o777, 0o555), (0o555, 0o777)])
    @runner
    def test_type_change_dir_to_link(self):
        """
        Test that the type of a file or directory can be changed.
        ---
