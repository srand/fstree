from jolt import attributes
from jolt import influence
from jolt import Alias, BooleanParameter, Parameter, Task, Test
from jolt.plugins import cmake
from jolt.plugins import git
from jolt.plugins import python
from jolt.pkgs import blake3
from jolt.pkgs import curl
from jolt.pkgs import grpc
from jolt.pkgs import googletest
from jolt.pkgs import ssl

import functools
import json
import os
import platform
import yaml


influence.global_string(str(platform.python_build()))


class Blake3(blake3.Blake3):
    """ Use static Blake3 library """
    name = "blake3"
    options = blake3.Blake3.options + [
        "CMAKE_POSITION_INDEPENDENT_CODE=ON",
    ]


class VirtualSsl(ssl.VirtualSsl):
    """ Use static SSL library (shared=False) """
    name = "virtual/ssl"
    shared = BooleanParameter(False, "Build shared SSL library")


class GoogleTest(googletest.GoogleTest):
    name = "google/test"
    options = googletest.GoogleTest.options + [
        "gtest_force_shared_crt=ON"
    ]


@attributes.requires("requires_{hash}")
@attributes.requires("requires_{http[curl,no_curl]}")
@cmake.requires()
@cmake.use_ninja()
@git.influence("CMakeLists.txt")
@git.influence("src")
@git.influence("test")
class Fstree(cmake.CMake):
    incremental = True
    debug = BooleanParameter(False, "Build with debug info")
    hash = Parameter("blake3", ["blake3", "sha1"], "Hash algorithm to use")
    http = BooleanParameter(True, "Enable HTTP remote support")
    jolt = BooleanParameter(True, "Enable JOLT remote support")
    pic = BooleanParameter(False, "Build with position independent code")
    config = "{debug[Debug,Release]}"
    requires = ["google/test", "grpc:pic={pic}"]
    requires_blake3 = ["blake3:pic={pic}"]
    requires_curl = ["curl:pic={pic}"]
    options = [
        "CMAKE_POSITION_INDEPENDENT_CODE={pic[ON,OFF]}",
        "fstree_HASH_ALGORITHM={hash}",
        "fstree_ENABLE_HTTP={http}",
        "fstree_ENABLE_JOLT={jolt}",
    ]


class PythonTestEnv(python.PythonEnv):
    name = "py-test"
    requirements = ["pyfstree"]


class FstreeDeps(Alias):
    name = "fstree/deps"
    requires = [
        "abseil:pic=true",
        "blake3:pic=true",
        "brotli:pic=true",
        "c-ares:pic=true",
        "curl:pic=true",
        "fstree:pic=true",
        "grpc:pic=true",
        "openssl",
        "protobuf:pic=true",
        "re2:pic=true",
        "virtual/ssl:pic=true",
        "virtual/zlib:pic=true",
        "zlib:pic=true",
        "zstd:pic=true",
    ]


class Default(Alias):
    requires = [
        "tests",
    ]


class Tests(Test):
    requires = ["fstree"]

    def get_config(self, tools, func, *args, **kwargs):
        # Split the docstring into two parts, the first part is the
        # description of the test, the second part is the expected
        # tree structure in YAML format.
        doc = func.__doc__.format(*args, **kwargs)
        doc, tree = doc.split("---", 1)

        # Parse the expected tree structure.
        from io import StringIO
        stream = StringIO(tree)
        return yaml.safe_load(stream)

    def create_ignore(self, tools, ignores):
        # Create the ignore file.
        ignores = "\n".join(ignores)
        self.tools.write_file(".fstreeignore", ignores)

    def create_tree(self, tools, tree):
        # Create the expected tree structure.
        for entry in tree:
            parts = entry.split()
            if parts[0] == "f":
                self.tools.write_file(parts[2])
            elif parts[0] == "d":
                self.tools.mkdir(parts[2])
            elif parts[0] == "l":
                self.tools.symlink(parts[3], parts[2])

            # Set the permissions of the file or directory.
            perms = int(parts[1])
            self.tools.chmod(parts[2], perms)

    def test_unittests(self):
        """
        Run the unittests.
        ---
        """
        self.tools.run("fstree_test")

    def test_irregular_bytes_in_event_paths(self):
        """Test irregular filenames survive checkout and produce UTF-8 JSON."""

        # None of these characters exist in a legacy Windows code page, so they
        # only survive a build that reads and writes paths through the wide
        # entry points. The emoji is outside the BMP and so is a surrogate pair
        # in UTF-16. None of them have a canonical decomposition, which keeps
        # the comparison immune to the normalization macOS applies on HFS+.
        #
        # They are spelled as escapes to keep this recipe pure ASCII: Jolt reads
        # recipes with the locale encoding, which is a legacy code page such as
        # cp1252 on Windows, and any literal non-ASCII byte here would fail to
        # decode before a single task runs.
        filenames = [
            "\u65e5\u672c\u8a9e",  # Japanese "nihongo"
            "\U0001f4c1",  # File folder emoji, U+1F4C1
            "\u041a\u0438\u0440\u0438\u043b\u043b\u0438\u0446\u0430",  # Russian "Kirillica"
        ]

        with self.tools.tmpdir("irregular-bytes") as tmp, self.tools.cwd(tmp):
            source = os.path.join(tmp, "source")
            actual = os.path.join(tmp, "actual")
            os.mkdir(source)
            os.mkdir(actual)

            # Names that are not valid UTF-8 at all are only expressible where
            # the filesystem stores names as opaque bytes. Windows names are
            # UTF-16, and macOS validates the encoding and rejects these with
            # EILSEQ, so add them only where they can actually be created.
            for raw in [b"invalid-\xff", b"truncated-\xe2\x82", b"continuation-\x80"]:
                try:
                    name = os.fsdecode(raw)
                    probe = os.path.join(source, name)
                    os.close(os.open(probe, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600))
                except (OSError, UnicodeError):
                    break
                os.unlink(probe)
                filenames.append(name)

            for filename in filenames:
                with open(os.path.join(source, filename), "wb") as stream:
                    stream.write(os.fsencode(filename))

            invocation = 0

            def run_json(*args):
                nonlocal invocation
                stderr_path = os.path.join(tmp, "events-{}.json".format(invocation))
                invocation += 1
                stdout = self.tools.run(
                    "fstree --json --cache cache {} 2> {}", " ".join(args), stderr_path
                )
                with open(stderr_path, "rb") as stream:
                    stderr_bytes = stream.read()
                try:
                    stderr = stderr_bytes.decode("utf-8")
                except UnicodeDecodeError as error:
                    context = stderr_bytes[max(0, error.start - 80):error.end + 80]
                    raise AssertionError(
                        "event stream is not UTF-8 at byte {}: {!r}".format(error.start, context)
                    ) from error
                events = [json.loads(line) for line in stderr.splitlines()]
                self.assertTrue(events)
                return stdout.strip(), events

            tree, write_events = run_json("write-tree", "source")
            _, checkout_events = run_json("checkout", tree, "actual")

            actual_filenames = set(os.listdir(actual)) - {".fstree"}
            self.assertEqual(actual_filenames, set(filenames))

            # escape() emits one \u00XX escape per byte, so a decoded path is a
            # string of code points 0-255 that latin-1 turns back into exactly
            # the bytes fstree saw.
            event_paths = [
                event.get("path", "").encode("latin-1")
                for event in write_events + checkout_events
            ]
            for filename in filenames:
                encoded = os.fsencode(filename)
                self.assertTrue(any(encoded in path for path in event_paths), repr(filename))

    def runner(func):

        @functools.wraps(func)
        def wrap(self, *args, **kwargs):
            # Get the configuration for the test from docstring.
            conf = self.get_config(self.tools, func, *args, **kwargs)

            with self.tools.tmpdir(func.__name__) as tmp, self.tools.cwd(tmp):
                self.tools.mkdir("tree")
                self.tools.mkdir("expected")
                self.tools.mkdir("actual")

                with self.tools.cwd("tree"):
                    if "ignores" in conf:
                        self.create_ignore(self.tools, conf["ignores"])
                    self.create_tree(self.tools, conf.get("tree", []))

                with self.tools.cwd("actual"):
                    self.create_tree(self.tools, conf.get("checkout", []))

                with self.tools.cwd("expected"):
                    # The ignore file is part of the tree and gets checked out
                    # along with it, so the expected result must contain it too.
                    if "ignores" in conf:
                        self.create_ignore(self.tools, conf["ignores"])
                    self.create_tree(self.tools, conf.get("expected", conf.get("tree", [])))

                # Write the tree. The ignore file lives in the source tree and
                # decides what is included, so write-tree must run on that tree
                # and not on the already filtered expected result.
                tree = self.tools.run("fstree write-tree tree")
                self.tools.run("fstree ls-tree {}", tree)

                # Checkout the tree
                self.tools.run("fstree checkout {} actual", tree)

                # Compare the expected tree structure with the actual tree
                if os.name in ["nt"]:
                    self.tools.run("diff.exe -rq --exclude .fstree expected actual")
                else:
                    self.tools.run("diff -rq --exclude .fstree expected actual")

                # Compare trees
                with self.tools.cwd("actual"):
                    self.tools.rmtree(".fstree")
                new_tree = self.tools.run("fstree write-tree actual")
                self.tools.run("fstree ls-tree {}", new_tree)
                self.assertEqual(tree, new_tree)

        return wrap

    @Test.parameterized([
            0o400, 0o440, 0o444, 0o600, 0o640, 0o644,
            0o660, 0o664, 0o666, 0o700, 0o740, 0o744,
            0o750, 0o754, 0o755, 0o760, 0o764, 0o766,
            0o770, 0o774, 0o777
        ] if os.name != "nt" else [0o777, 0o555]
    )
    @runner
    def test_permissions_at_checkout(self):
        """
        Test that permissions of a newly checked out tree matches
        permissions of files and directories of the original tree.
        ---
        tree:
        - d {0} dir
        - f {0} file
        - l {0} link file
        """

    @Test.parameterized([
            0o700, 0o740, 0o744, 0o750, 0o754, 0o755,
            0o760, 0o764, 0o766, 0o770, 0o774, 0o777
        ] if os.name != "nt" else [0o777, 0o555]
    )
    @runner
    def test_dir_permissions_at_checkout(self):
        """
        Test that permissions of a newly checked out tree matches
        permissions of files and directories of the original tree.
        ---
        tree:
        - d {0} dir
        - f {0} dir/file
        - d {0} dir/dir
        - l {0} dir/link file
        """

    @Test.parameterized([
            (0o700, 0o700), (0o700, 0o740), (0o700, 0o744),
            (0o700, 0o750), (0o700, 0o754), (0o700, 0o755),
            (0o700, 0o760), (0o700, 0o764), (0o700, 0o766),
            (0o700, 0o770), (0o700, 0o774), (0o700, 0o777),
        ] if os.name != "nt" else [(0o777, 0o555), (0o555, 0o777)])
    @runner
    def test_type_change_file_to_dir(self):
        """
        Test that the type of a file or directory can be changed.
        ---
        tree:
        - d {0} dir
        - d {0} dir/subdir
        - f {0} dir/file
        checkout:
        - f {0} dir
        - f {0} file
        """

    @Test.parameterized([
            (0o700, 0o700), (0o700, 0o740), (0o700, 0o744),
            (0o700, 0o750), (0o700, 0o754), (0o700, 0o755),
            (0o700, 0o760), (0o700, 0o764), (0o700, 0o766),
            (0o700, 0o770), (0o700, 0o774), (0o700, 0o777),
        ] if os.name != "nt" else [(0o777, 0o555), (0o555, 0o777)])
    @runner
    def test_type_change_dir_to_file(self):
        """
        Test that the type of a file or directory can be changed.
        ---
        tree:
        - f {0} dir
        - f {0} file
        checkout:
        - d {0} dir
        - d {0} dir/subdir
        - f {0} dir/file
        """

    @Test.parameterized([
            (0o700, 0o700), (0o700, 0o740), (0o700, 0o744),
            (0o700, 0o750), (0o700, 0o754), (0o700, 0o755),
            (0o700, 0o760), (0o700, 0o764), (0o700, 0o766),
            (0o700, 0o770), (0o700, 0o774), (0o700, 0o777),
        ] if os.name != "nt" else [(0o777, 0o555), (0o555, 0o777)])
    @runner
    def test_type_change_dir_to_link(self):
        """
        Test that the type of a file or directory can be changed.
        ---
        tree:
        - f {0} file
        - l {0} dir file
        checkout:
        - d {0} dir
        - d {0} dir/subdir
        - f {0} dir/file
        """

    @Test.parameterized([
            (0o700, 0o700), (0o700, 0o740), (0o700, 0o744),
            (0o700, 0o750), (0o700, 0o754), (0o700, 0o755),
            (0o700, 0o760), (0o700, 0o764), (0o700, 0o766),
            (0o700, 0o770), (0o700, 0o774), (0o700, 0o777),
        ] if os.name != "nt" else [(0o777, 0o555), (0o555, 0o777)])
    @runner
    def test_type_change_link_to_dir(self):
        """
        Test that the type of a file or directory can be changed.
        ---
        tree:
        - d {0} dir
        - d {0} dir/subdir
        - f {0} dir/file
        checkout:
        - f {0} file
        - l {0} dir file
        """

    @Test.parameterized([
            (0o700, 0o700), (0o700, 0o740), (0o700, 0o744),
            (0o700, 0o750), (0o700, 0o754), (0o700, 0o755),
            (0o700, 0o760), (0o700, 0o764), (0o700, 0o766),
            (0o700, 0o770), (0o700, 0o774), (0o700, 0o777),
        ] if os.name != "nt" else [(0o777, 0o555), (0o555, 0o777)])
    @runner
    def test_permissions_change(self):
        """
        Test that the permissions of a file or directory can be changed.
        ---
        tree:
        - d {0} dir
        - f {0} file
        - l {0} link file
        - d {0} dir2
        - f {0} dir2/file
        - l {0} dir2/link file
        - f {0} file2
        - d {0} dir3
        - f {0} dir3/file
        - l {0} dir3/link file
        checkout:
        - d {1} dir
        - f {1} file
        - l {1} link file
        - d {1} dir2
        - f {1} dir2/file
        - l {1} dir2/link file
        - f {1} file2
        - d {1} dir3
        - f {1} dir3/file
        - l {1} dir3/link file
        """

    @Test.parameterized([0o777])
    @runner
    def test_ignore(self):
        """
        Test that files and directories can be ignored.
        ---
        ignores:
        - dir2
        - file2
        tree:
        - d {0} dir
        - f {0} file
        - l {0} link file
        - d {0} dir2
        - f {0} dir2/file
        - l {0} dir2/link file
        - f {0} file2
        - d {0} dir3
        - f {0} dir3/file
        - l {0} dir3/link file
        checkout:
        - d {0} dir
        - f {0} file
        - l {0} link file
        - d {0} dir3
        - f {0} dir3/file
        - l {0} dir3/link file
        expected:
        - d {0} dir
        - f {0} file
        - l {0} link file
        - d {0} dir3
        - f {0} dir3/file
        - l {0} dir3/link file
        """

    @Test.parameterized([0o777])
    @runner
    def test_ignored_files_retained_on_checkout(self):
        """
        Test that files and directories can be ignored.
        ---
        ignores:
        - dir2
        - file2
        tree:
        - d {0} dir
        - f {0} file
        - l {0} link file
        - d {0} dir2
        - f {0} dir2/file
        - l {0} dir2/link file
        - f {0} file2
        - d {0} dir3
        - f {0} dir3/file
        - l {0} dir3/link file
        checkout:
        - d {0} dir
        - f {0} file
        - l {0} link file
        - d {0} dir2
        - f {0} dir2/file2
        expected:
        - d {0} dir
        - f {0} file
        - l {0} link file
        - d {0} dir2
        - f {0} dir2/file2
        - d {0} dir3
        - f {0} dir3/file
        - l {0} dir3/link file
        """


    @Test.parameterized([0o777])
    @runner
    def test_ignore_negation(self):
        """
        Test that a negated pattern re-includes an ignored file, and that it
        cannot re-include anything below an ignored directory.
        ---
        ignores:
        - '*.log'
        - '!keep.log'
        - dir2
        - '!dir2/keep.log'
        tree:
        - d {0} dir
        - f {0} dir/app.log
        - f {0} dir/keep.log
        - f {0} file
        - d {0} dir2
        - f {0} dir2/keep.log
        expected:
        - d {0} dir
        - f {0} dir/keep.log
        - f {0} file
        """


class Publish(Task):
    """ Downloads release wheels from GitHub and publishes them to PyPI. """

    version = Parameter("Version to publish")

    base_url = "https://github.com/srand/fstree/releases/download/{version_long}/"

    wheels = [
        "pyfstree-{version}-cp310-cp310-macosx_11_0_arm64.whl",
        "pyfstree-{version}-cp310-cp310-manylinux_2_28_x86_64.whl",
        "pyfstree-{version}-cp310-cp310-musllinux_1_2_x86_64.whl",
        "pyfstree-{version}-cp310-cp310-win_amd64.whl",

        "pyfstree-{version}-cp311-cp311-macosx_11_0_arm64.whl",
        "pyfstree-{version}-cp311-cp311-manylinux_2_28_x86_64.whl",
        "pyfstree-{version}-cp311-cp311-musllinux_1_2_x86_64.whl",
        "pyfstree-{version}-cp311-cp311-win_amd64.whl",

        "pyfstree-{version}-cp312-cp312-macosx_11_0_arm64.whl",
        "pyfstree-{version}-cp312-cp312-manylinux_2_28_x86_64.whl",
        "pyfstree-{version}-cp312-cp312-musllinux_1_2_x86_64.whl",
        "pyfstree-{version}-cp312-cp312-win_amd64.whl",

        "pyfstree-{version}-cp313-cp313-macosx_11_0_arm64.whl",
        "pyfstree-{version}-cp313-cp313-manylinux_2_28_x86_64.whl",
        "pyfstree-{version}-cp313-cp313-musllinux_1_2_x86_64.whl",
        "pyfstree-{version}-cp313-cp313-win_amd64.whl",

        "pyfstree-{version}-cp314-cp314-macosx_11_0_arm64.whl",
        "pyfstree-{version}-cp314-cp314-manylinux_2_28_x86_64.whl",
        "pyfstree-{version}-cp314-cp314-musllinux_1_2_x86_64.whl",
        "pyfstree-{version}-cp314-cp314-win_amd64.whl",
    ]

    @property
    def version_long(self):
        """ Adds a leading 0 to the minor version if it's a single digit. """
        major, minor, patch = str(self.version).split(".")
        if len(minor) == 1:
            minor = "0" + minor
        return f"{major}.{minor}.{patch}"

    def run(self, deps, tools):
        with tools.tmpdir() as tmp, tools.cwd(tmp):
            for wheel in self.wheels:
                tools.download(self.base_url + wheel, wheel)
            tools.run("twine upload *.whl")
