class Blake3(blake3.Blake3):
    """ Use static Blake3 library """
    name = "blake3"
    options = blake3.Blake3.options + [
        "CMAKE_POSITION_INDEPENDENT_CODE=ON",
    ]


class VirtualSsl(ssl.VirtualSsl):
    """ Use static SSL library (shared=False) """
    name = "virtual/ssl"
    shared = BooleanParameter(False, "Build shared SSL library")


class GoogleTest(googletest.GoogleTest):
    name = "google/test"
    options = googletest.GoogleTest.options + [
        "gtest_force_shared_crt=ON"
    ]


@attributes.requires("requires_{hash}")
@attributes.requires("requires_{http[curl,no_curl]}")
@cmake.requires()
@cmake.use_ninja()
@git.influence("CMakeLists.txt")
@git.influence("src")
@git.influence("test")
class Fstree(cmake.CMake):
    incremental = True
    debug = BooleanParameter(False, "Build with debug info")
    hash = Parameter("blake3", ["blake3", "sha1"], "Hash algorithm to use")
    http = BooleanParameter(True, "Enable HTTP remote support")
    jolt = BooleanParameter(True, "Enable JOLT remote support")
    pic = BooleanParameter(False, "Build with position independent code")
    config = "{debug[Debug,Release]}"
    requires = ["google/test", "grpc:pic={pic}"]
    requires_blake3 = ["blake3:pic={pic}"]
    requires_curl = ["curl:pic={pic}"]
    options = [
        "CMAKE_POSITION_INDEPENDENT_CODE={pic[ON,OFF]}",
        "fstree_HASH_ALGORITHM={hash}",
        "fstree_ENABLE_HTTP={http}",
        "fstree_ENABLE_JOLT={jolt}",
    ]


class PythonTestEnv(python.PythonEnv):
    name = "py-test"
    requirements = ["pyfstree"]


